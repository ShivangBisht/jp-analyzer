{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TeachingCorpusGovernance.v1",
  "type": "object",
  "required": [
    "schema",
    "mode",
    "counts",
    "coverage",
    "provenance",
    "maturity",
    "gaps",
    "recommendations",
    "reportDigest"
  ],
  "properties": {
    "schema": {
      "const": "TeachingCorpusGovernance.v1"
    },
    "mode": {
      "const": "governance-read-only"
    },
    "tuningEnabled": {
      "const": false
    },
    "activationEnabled": {
      "const": false
    },
    "deploymentEnabled": {
      "const": false
    },
    "reportDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}